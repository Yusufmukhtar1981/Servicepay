# Copy this file to .env and add your real secret values.
CLUBKONNECT_API_KEY=
CLUBKONNECT_USER_ID=
JWT_SECRET=
MONGODB_URI=
NELLOBYTES_APIKEY=
NELLOBYTES_USERID=
PAYSTACK_SECRET_KEY=
PORT=

# ==============================
# SERVICEPAY EMAIL NOTIFICATIONS
# ==============================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=ServicePay
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
FRONTEND_URL=https://servicepay.ng

# ==============================
# SERVICEPAY AI SUPPORT (OPTIONAL)
# ==============================
# Without a configured provider, AI Support uses its secure local FAQ fallback.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional OpenAI-compatible chat-completions endpoint.
AI_API_URL=
AI_TIMEOUT_MS=15000
