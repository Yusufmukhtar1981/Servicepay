VULL_ENV=sandbox
VULL_SANDBOX_MONGODB_URI=mongodb://127.0.0.1:27017/vull_sandbox
VULL_SANDBOX_MONGO_ALLOWED_HOSTS=127.0.0.1
VULL_SANDBOX_MONGO_DATABASE=vull_sandbox
# sha256("host/database"), comma-separated; never include URI credentials
VULL_PRODUCTION_MONGO_FINGERPRINTS=replace-with-production-host-database-fingerprint
VULL_SANDBOX_AUTH_PEPPER=replace-with-sandbox-only-pepper
VULL_SANDBOX_WEBHOOK_SIGNING_SECRET=replace-with-sandbox-only-webhook-secret
VULL_SANDBOX_PORT=3003
VULL_SANDBOX_WORKER_POLL_INTERVAL_MS=1000
VULL_SANDBOX_CREDENTIAL_OUTPUT_FILE=/secure/path/vull-sandbox-credentials.json