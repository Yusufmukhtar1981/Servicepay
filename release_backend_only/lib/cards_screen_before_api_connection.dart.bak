import 'package:flutter/material.dart';

class CardsScreen extends StatefulWidget {
  const CardsScreen({super.key});

  @override
  State<CardsScreen> createState() => _CardsScreenState();
}

class _CardsScreenState extends State<CardsScreen> {
  static const Color primaryGreen = Color(0xFF08783E);
  static const Color softGreen = Color(0xFFEAF7F0);
  static const Color background = Color(0xFFF7F9F8);

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: background,
      appBar: AppBar(
        elevation: 0,
        backgroundColor: Colors.white,
        foregroundColor: const Color(0xFF17211B),
        title: const Text(
          'ServicePay Cards',
          style: TextStyle(
            fontWeight: FontWeight.w800,
          ),
        ),
      ),
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.fromLTRB(18, 18, 18, 30),
          children: <Widget>[
            const Text(
              'Your Cards',
              style: TextStyle(
                fontSize: 25,
                fontWeight: FontWeight.w900,
                color: Color(0xFF17211B),
              ),
            ),
            const SizedBox(height: 6),
            const Text(
              'Manage your ServicePay virtual and physical cards.',
              style: TextStyle(
                fontSize: 14,
                height: 1.45,
                color: Color(0xFF66736C),
              ),
            ),
            const SizedBox(height: 22),
            _buildVirtualCard(),
            const SizedBox(height: 22),
            _buildSectionTitle(
              icon: Icons.credit_card_rounded,
              title: 'Virtual Card',
            ),
            const SizedBox(height: 12),
            _buildOptionCard(
              icon: Icons.flash_on_rounded,
              title: 'Create Virtual Card',
              subtitle:
                  'Create a digital ServicePay card for supported online payments.',
              buttonText: 'Get Virtual Card',
              onTap: () {
                _showComingSoon(
                  'Virtual Card',
                  'Virtual card issuance will become available after the secure card issuing provider is connected.',
                );
              },
            ),
            const SizedBox(height: 24),
            _buildSectionTitle(
              icon: Icons.style_rounded,
              title: 'Physical Card',
            ),
            const SizedBox(height: 12),
            _buildOptionCard(
              icon: Icons.local_shipping_outlined,
              title: 'Request Physical Card',
              subtitle:
                  'Request your ServicePay ATM card and track production and delivery.',
              buttonText: 'Request Card',
              onTap: () {
                Navigator.push(
                  context,
                  MaterialPageRoute<void>(
                    builder: (_) => const PhysicalCardRequestScreen(),
                  ),
                );
              },
            ),
            const SizedBox(height: 24),
            _buildSecurityCard(),
          ],
        ),
      ),
    );
  }

